ENV=dev

# JWT signing secret. Use a unique value with at least 32 bytes.
SECRET_KEY=change-me-at-least-32-bytes-value

# Secret used to encrypt provider API keys at rest. Use a unique value.
API_KEY_ENCRYPTION_SECRET=change-me-at-least-32-bytes-value

DATABASE_URL=mysql+pymysql://rag:change-me@mysql:3306/rag_manage?charset=utf8mb4

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=rag_minio
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=rag-files
MINIO_SECURE=false

ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=rag_chunks

MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=rag_chunks
DEFAULT_EMBEDDING_DIMENSION=1024

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
